// What: TypeScript configuration used only for type checking the JavaScript sources via JSDoc
//     (checkJs, strict, noEmit).
// Why: Catches type errors in plain JavaScript without a build step, so packages run directly on
//     Node.
// If missing or unlinked: npm run typecheck fails; if include paths are broken, files are
//     silently skipped and type errors go undetected.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "types/**/*.d.ts",
    "scripts/**/*.js",
    "packages/*/src/**/*.js",
    "packages/*/bin/**/*.js"
  ],
  "exclude": [
    "**/node_modules/**",
    "packages/*/templates/**"
  ]
}
