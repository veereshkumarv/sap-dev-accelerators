# What: npm settings for this repo: exact dependency versions, enforced Node engine, no funding
#     messages.
# Why: Exact versions make builds reproducible; engine-strict stops installs on unsupported Node
#     versions.
# If missing or unlinked: npm saves caret ranges (silent upgrades between builds) and installs on
#     Node versions the tools do not support.
save-exact=true
engine-strict=true
fund=false
