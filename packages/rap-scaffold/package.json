{
  "name": "@sapdx/rap-scaffold",
  "version": "0.1.0",
  "description": "Tool 1 (RAP): generates clean-core RAP business objects in abapGit format from a BO model.",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "rap-scaffold": "./bin/rap-scaffold.js"
  },
