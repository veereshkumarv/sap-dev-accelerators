// What: Access control for ZC_SD_ITEM, inheriting the conditions of ZR_SD_ITEM.
// Why: Projections must enforce the same authorization as the base view.
// If missing or unlinked: The projection is not protected by an access control; ABAP-SEC-001 is
//     violated.
@EndUserText.label: 'Access control for ZC_SD_ITEM'
@MappingRole: true
define role ZC_SD_ITEM {
  grant select on ZC_SD_ITEM
    where inheriting conditions from entity ZR_SD_ITEM;
}
