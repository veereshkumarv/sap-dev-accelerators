// What: UI metadata extension for ZC_SD_ORDER: Fiori elements list, object page and facets.
// Why: Keeps UI annotations out of the data model and lets the customer layer adjust the UI.
// If missing or unlinked: The Fiori elements preview shows no columns or facets; the service
//     itself still works.
@Metadata.layer: #CUSTOMER
@UI: { headerInfo: { typeName: 'Sales Order',
                     typeNamePlural: 'Sales Orders',
                     title: { type: #STANDARD, value: 'OrderId' } } }
annotate entity ZC_SD_ORDER with
{
  @UI.facet: [ { id: 'General', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Sales Order', position: 10 },
               { id: 'Item', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Sales Order Item', position: 20, targetElement: '_Item' } ]
  @UI.hidden: true
  OrderUUID;

  @UI: { lineItem:       [ { position: 10 } ],
         identification: [ { position: 10 } ],
         selectionField: [ { position: 10 } ] }
  OrderId;

  @UI: { lineItem:       [ { position: 20 } ],
         identification: [ { position: 20 } ],
         selectionField: [ { position: 20 } ] }
  Customer;

  @UI: { lineItem:       [ { position: 30 } ],
         identification: [ { position: 30 } ],
         selectionField: [ { position: 30 } ] }
  Description;

  @UI: { lineItem:       [ { position: 40 } ],
         identification: [ { position: 40 } ] }
  OrderDate;

  @UI: { lineItem:       [ { position: 50 } ],
         identification: [ { position: 50 } ] }
  NetAmount;

  @UI: { lineItem:       [ { position: 60 } ],
         identification: [ { position: 60 } ] }
  CurrencyCode;

  @UI: { lineItem:       [ { position: 70 } ],
         identification: [ { position: 70 } ] }
  Status;
}
