{
  "//": [
    "What: Package manifest for @sapdx/s4-mock (Tool 4): stateful S/4HANA API mock with fault injection, built as a CAP app.",
    "Why: CAP teams can develop and test integrations without waiting for a shared S/4 system.",
    "If missing or unlinked: The mock server cannot be started; integration tests depend on a real S/4 system again."
  ],
  "name": "@sapdx/s4-mock",
  "version": "0.1.0",
  "description": "Tool 4: stateful S/4HANA API mock (Business Partner, Sales Order, Product) with fault injection.",
  "type": "commonjs",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "s4-mock": "./bin/s4-mock.js"
  },
  "files": [
    "index.js",
    "server.js",
    "src",
    "srv",
    "db",
    "bin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=85 --test-coverage-include=src/** --test-coverage-include=srv/** --test-coverage-include=server.js \"test/*.test.js\"",
    "start": "cds-serve"
  },
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "1.16.3",
    "@cap-js/sqlite": "3.1.3",
    "@sap/cds": "10.2.2",
    "express": "5.3.0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "S4USER": {
            "password": "mock",
            "roles": [
              "S4Reader",
              "S4Writer"
            ]
          },
          "READONLY": {
            "password": "mock",
            "roles": [
              "S4Reader"
            ]
          }
        }
      }
    },
    "cov2ap": {
      "path": "sap/opu/odata/sap"
    },
    "s4mock": {}
  }
}
