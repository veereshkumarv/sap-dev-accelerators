  "dependencies": {
    "@sapdx/findings": "0.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "picomatch": "4.0.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/picomatch": "4.0.3"
  }
