{
  "name": "@sapdx/policy",
  "version": "0.1.0",
  "description": "Central policy engine: rule catalog, time-boxed exemptions, naming conventions and the SARIF quality gate.",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
