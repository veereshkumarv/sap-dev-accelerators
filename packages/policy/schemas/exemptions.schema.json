{
  "$id": "https://sapdx.local/schemas/exemptions.schema.json",
  "type": "object",
  "required": ["version", "exemptions"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "exemptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule", "owner", "approver", "justification", "created", "expires", "backlog"],
        "anyOf": [{ "required": ["object"] }, { "required": ["path"] }],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^EXM-[0-9]{4,}$" },
          "rule": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9_]+)+$" },
          "object": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 2 },
          "approver": { "type": "string", "minLength": 2 },
          "justification": { "type": "string", "minLength": 20 },
          "created": { "type": "string", "format": "date" },
          "expires": { "type": "string", "format": "date" },
          "backlog": { "type": "string", "minLength": 2 }
        }
      }
    }
  }
}
