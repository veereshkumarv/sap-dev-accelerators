{
  "$id": "https://sapdx.local/schemas/rules.schema.json",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "tool"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9_]+)*(-[A-Z0-9_]+|-\\*)$" },
          "title": { "type": "string", "minLength": 3 },
          "severity": { "enum": ["blocker", "critical", "major", "minor"] },
          "tool": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "helpUri": { "type": "string" },
          "enabled": { "type": "boolean" },
          "baselineable": { "type": "boolean" }
        }
      }
    }
  }
}
