{
  "name": "@sapdx/odata-testgen",
  "version": "0.1.0",
  "description": "Tool 3: generates OData regression tests (node:test + cds.test, Postman) from service metadata.",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "odata-testgen": "./bin/odata-testgen.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=85 --test-coverage-include=src/** test/"
  },
  "dependencies": {
    "@sapdx/sap-metadata": "0.1.0",
    "yaml": "2.9.1"
  }
}
