# What: Editor settings (UTF-8, LF, 2-space indent, final newline) for all files, including
#     ABAP/CDS sources.
# Why: Keeps diffs clean and formatting identical across VS Code, Eclipse ADT and other editors.
# If missing or unlinked: Editors fall back to personal defaults; mixed indentation and line
#     endings create noisy diffs and review friction.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{abap,asddls,asdcls,asbdef,srvdsrv}]
indent_size = 2
